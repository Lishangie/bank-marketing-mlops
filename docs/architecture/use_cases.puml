@startuml use_cases
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 20
skinparam usecase {
  BackgroundColor #EEF3F8
  BorderColor #3C5A78
}
skinparam rectangle {
  BorderColor #555555
}
left to right direction
' Все акторы слева: связи входят в границу системы сбоку и не пересекают её заголовок.

actor "Руководитель\nкампании" as manager
actor "CRM банка\n<<система>>" as crm
actor "ML-инженер" as mle
rectangle "Система прогноза отклика" {
  usecase "Получить список\nобзвона" as calllist
  usecase "Просмотреть\nпоказатели" as view
  usecase "Запустить обработку\nпорции" as run
  usecase "Передать порцию" as send
  usecase "Передать итоги\nзвонков" as results
  usecase "Получить прогноз\nпо клиенту" as single
  usecase "Проверить качество\nданных" as check
  usecase "Сформировать\nпризнаки" as feats
  usecase "Получить\nпредсказания" as predict
  usecase "Пересчитать\nпоказатели" as kpi
  usecase "Обучить модель" as train
  usecase "Зарегистрировать\nмодель" as register
  usecase "Проанализировать\nдрейф" as drift
  usecase "Запустить\nпереобучение" as retrain
}
manager --> run
manager --> view
manager --> calllist
run ..> check : <<include>>
run ..> feats : <<include>>
run ..> predict : <<include>>
run ..> kpi : <<include>>
crm --> send
crm --> results
crm --> single
mle --> train
mle --> register
mle --> drift
mle --> retrain
retrain ..> drift : <<extend>>
@enduml
