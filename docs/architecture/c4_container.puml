@startuml c4_container
!pragma layout smetana
!include <C4/C4_Container>
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 13
' Технология в [ ] — тем же кеглем, что и описание (по умолчанию мельче).
!$TECHN_FONT_SIZE = 13
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()

System_Ext(crm, "CRM банка")
System_Ext(macro, "Источник\nмакропоказателей")

' Колонки: модели/MLflow — приём/проверка/подготовка/скоринг —
' показатели/хранилище/API — панель (раскладка smetana).
Boundary(system, "Система прогноза отклика") {
  Container(ingest, "Приём порций", "Python, DVC", "Чтение и типы")
  Container(train, "Обучение\nмоделей", "CatBoost, sklearn", "Обучение и оценка")
  Container(monitor, "Расчёт показателей\nи мониторинг", "Python, Evidently", "Показатели и дрейф")
  Container(validate, "Проверка качества", "Python", "Проверки D-01…D-09")
  Container(mlflow, "MLflow", "Tracking, Registry", "Версии моделей")
  ContainerDb(store, "Хранилище данных", "Parquet/CSV, DVC", "Порции, признаки, прогнозы")
  Container(prep, "Подготовка данных\nи признаков", "pandas, sklearn", "Очистка и признаки")
  Container(score, "Пакетный скоринг", "Python", "Вероятности и ранги")
  Container(panel, "Панель показателей", "Streamlit", "Значения и динамика")
  Container(api, "API прогноза", "FastAPI", "Прогноз по клиенту")
}

' Ряды задаются невидимыми связями сверху (Lay_D) и направлением связей
' (Rel_U — цель выше). Подписанные связи идут только между рядами:
' smetana не строит подписанные рёбра внутри одного ряда.
Lay_R(macro, crm)
Lay_D(macro, train)
Lay_D(crm, monitor)
Lay_D(store, panel)
Lay_D(panel, api)

Rel(crm, ingest, "Порции, итоги")
Rel(macro, ingest, "Показатели")
Rel(ingest, validate, "Порция")
Rel(validate, prep, "Данные")
Rel(prep, score, "Признаки")
Rel_U(prep, store, "Признаки,\nпараметры")
Rel(train, mlflow, "Модели")
Rel(train, store, "Признаки")
Rel_U(score, mlflow, "Модель")
Rel_U(score, store, "Вероятности")
Rel(monitor, store, "Метки, витрина")
Rel_U(panel, store, "Витрина")
Rel_U(api, mlflow, "Модель")
Rel_U(api, store, "Параметры")
Rel_U(store, crm, "Список обзвона")
@enduml
