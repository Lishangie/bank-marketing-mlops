@startuml activity_pipeline
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
' Высоту сокращают внутренние отступы блоков (стиль Padding);
' skinparam ActivityMarginTop/Bottom на раскладку не влияли и убраны.
' Детали очистки (дубликаты, диапазоны, 999 → флаг, редкие и неизвестные
' категории) в рисунок не вошли — даже заметка или две строки в блоке
' выводят его за 1339 px; они перечислены в тексте отчёта.
<style>
activityDiagram {
  activity {
    Padding 4
  }
  diamond {
    Padding 2
  }
}
</style>
skinparam activity {
  BackgroundColor #EEF3F8
  BorderColor #3C5A78
}

|Общие шаги|
start
:Загрузка: чтение, типы,
удаление duration;
:Проверка качества;
if (Критическое нарушение?) then (да)
  :Отчёт о проверке;
  stop
else (нет)
endif
:Очистка;
if (Режим?) then (обучение)
  |Только обучение|
  :Оценить параметры преобразований
  по обучающим данным;
  :Сохранить параметры;
else (порция)
  |Только порция|
  :Загрузить сохранённые
  параметры;
endif
|Общие шаги|
:Формирование признаков;
:Сохранение таблицы признаков
(Parquet, версия DVC);
stop
@enduml
